{
  "name": "telescope-toc",
  "version": "0.1.0",
  "description": "A Table of Contents source plugin for Telescope",
  "keywords": [
    "outline",
    "telescope",
    "toc"
  ],
  "license": "MIT",
  "repository": "https://github.com/inkdropapp/telescope-toc",
  "main": "./lib/index.js",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@inkdropapp/types": "^0.0.12",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "inkdrop": "^6.x"
  },
  "styleSheets": [
    "styles/toc.css"
  ]
}
